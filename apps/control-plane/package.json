{
  "name": "@opencyber/control-plane",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_USE_ENV_PROXY=1 vitest run",
    "dev": "NODE_USE_ENV_PROXY=1 tsx src/cli.ts",
    "start": "NODE_USE_ENV_PROXY=1 node dist/cli.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@opencyber/agents": "workspace:*",
    "@opencyber/egress-gateway": "workspace:*",
    "@opencyber/gitops-engine": "workspace:*",
    "@opencyber/sandbox-runner": "workspace:*",
    "@opencyber/sec-harness": "workspace:*",
    "@opencyber/shared": "workspace:*",
    "dotenv": "^18.0.9",
    "hono": "^4.13.16",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
