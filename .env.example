# OpenCyber (Aegis-GitOps) Environment Configuration
# Copy this file to .env and fill in your credentials.

# Cloud Sandbox Execution Plane (E2B)
E2B_API_KEY=e2b_your_api_key_here

# Lead Orchestrator Reasoning Plane (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your_api_key_here
AEGIS_ORCHESTRATOR_PROVIDER=openrouter
OPENROUTER_ORCHESTRATOR_MODEL=stealth/crouton-alpha

# Subagent Worker & Prompt Guard Plane (Groq)
GROQ_API_KEY=gsk_your_api_key_here
GROQ_ORCHESTRATOR_MODEL=openai/gpt-oss-120b
GROQ_SUBAGENT_MODEL=qwen/qwen3.8-27b
GROQ_PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# Control Plane & Proxy Signing Secret
AEGIS_HMAC_SECRET=change-me-in-production-32-byte-secret-key
PORT=4100
NODE_USE_ENV_PROXY=1
